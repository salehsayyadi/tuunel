[Unit]
Description=tuunel multi-carrier L3 tunnel
Documentation=https://github.com/salehsayyadi/tuunel
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=tuunel
Group=tuunel
ExecStartPre=/usr/local/bin/tuunel check -config /etc/tuunel/config.yaml
ExecStartPre=+/usr/local/bin/tuunel underlay-up -config /etc/tuunel/config.yaml
ExecStart=/usr/local/bin/tuunel run -config /etc/tuunel/config.yaml
# "route all" internet exit (config exit:), applied as root outside the sandbox;
# no-op without an exit section
ExecStartPost=+/usr/local/bin/tuunel exit-up -config /etc/tuunel/config.yaml
ExecStopPost=+/usr/local/bin/tuunel exit-down -config /etc/tuunel/config.yaml
ExecStopPost=+/usr/local/bin/tuunel underlay-down -config /etc/tuunel/config.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=15

# Capabilities: TUN/netlink (NET_ADMIN), raw ICMP carrier (NET_RAW, only
# used when experimental.icmp is enabled), privileged ports (NET_BIND_SERVICE).
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Filesystem
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/etc/tuunel
RuntimeDirectory=tuunel
RuntimeDirectoryMode=0750
StateDirectory=tuunel
UMask=0077

# Devices: only the TUN clone device
DevicePolicy=closed
DeviceAllow=/dev/net/tun rw

# Kernel / process hardening compatible with TUN + netlink
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @mount @reboot @swap @module @obsolete @cpu-emulation @debug

# Resource limits
LimitNOFILE=65536
TasksMax=4096
MemoryMax=512M

[Install]
WantedBy=multi-user.target
